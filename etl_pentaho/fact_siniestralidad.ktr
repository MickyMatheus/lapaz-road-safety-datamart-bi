    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here

// 1. Contador aditivo
var cantidad_involucrados = 1;

// 2. Indicadores binarios
var es_fallecido = 0;
if (lesion_aparente != null &amp;&amp; lesion_aparente.toUpperCase().indexOf("FALLECIDO") >= 0) {
    es_fallecido = 1;
}

var es_herido_grave = 0;
if (lesion_aparente != null) {
    var les = lesion_aparente.toUpperCase();
    if (les.indexOf("GRAVE") >= 0 || les.indexOf("FRACTURA") >= 0) {
        es_herido_grave = 1;
    }
}

var genero_traslado_medico = 0;
if (id_centro_medico != null) {
    genero_traslado_medico = 1;
}

var grado_alcohol_medido = 0.0;
if (grado_alcohol_sangre != null) {
    grado_alcohol_medido = Number(grado_alcohol_sangre);
}


// Normalizar fecha_suceso para que coincida con dim_tiempo
var fecha_limpia_str = "";

if (fecha_suceso != null) {
    var f_str = String(fecha_suceso).trim();
    
    // Si viene en formato latino DD/MM/YYYY (ej: 27/02/2024)
    if (f_str.indexOf('/') >= 0) {
        var partes = f_str.split('/');
        if (partes.length === 3) {
            // Reordenar a YYYY-MM-DD
            fecha_limpia_str = partes[2] + '-' + partes[1] + '-' + partes[0] + ' 00:00:00';
        }
    } 
    // Si ya viene en formato YYYY-MM-DD (ej: 2024-04-25)
    else if (f_str.indexOf('-') >= 0) {
        // Tomar solo los primeros 10 caracteres (YYYY-MM-DD) y agregarle la hora
        fecha_limpia_str = f_str.substring(0, 10) + ' 00:00:00';
    }
}

// 1. Limpieza estándar (mayúsculas y espacios)
var macrodistrito_limpio = (macrodistrito != null) ? String(macrodistrito).trim().toUpperCase() : "";

// 2. Estandarización de nombres específicos
if (macrodistrito_limpio == "COTA HUMA") {
    macrodistrito_limpio = "COTAHUMA";
} else if (macrodistrito_limpio == "M. PAREDES") {
    macrodistrito_limpio = "MAX PAREDES";
} else if (macrodistrito_limpio == "SUR") {
    macrodistrito_limpio = "ZONA SUR";
}
var barrio_zona_limpio = (barrio_zona != null) ? String(barrio_zona).trim().toUpperCase() : "";
var calle_principal_limpia = (calle_principal != null) ? String(calle_principal).trim().toUpperCase() : "";

// Limpieza y estandarización a Mayúsculas para los Lookups
var clima_limpio = (clima != null) ? String(clima).trim().toUpperCase() : "";
var iluminacion_limpia = (iluminacion != null) ? String(iluminacion).trim().toUpperCase() : "";
var estado_via_limpio = (estado_via != null) ? String(estado_via).trim().toUpperCase() : "";

var tipo_vehiculo_limpio = (tipo_vehiculo != null) ? String(tipo_vehiculo).trim().toUpperCase() : "";
var marca_limpia = (marca != null) ? String(marca).trim().toUpperCase() : "";
var aseguradora_limpia = (aseguradora_soat != null) ? String(aseguradora_soat).trim().toUpperCase() : "SIN SOAT";
var estado_vehiculo_limpio = (estado_vehiculo != null) ? String(estado_vehiculo).trim().toUpperCase() : "DESCONOCIDO";

var rol_limpio = (rol_involucrado != null) ? String(rol_involucrado).trim().toUpperCase() : "";
var genero_limpio = (genero != null) ? String(genero).trim().toUpperCase() : "";


// 1. Cálculo exacto de la edad_calculada usando la fecha_nacimiento
var edad_calculada = 0;
if (fecha_nacimiento != null) {
    var f_nac_str = String(fecha_nacimiento).trim();
    var anio_nac = parseInt(f_nac_str.substring(0, 4));
    if (!isNaN(anio_nac)) {
        edad_calculada = 2026 - anio_nac;
    } else {
        edad_calculada = 0; // Valor por defecto si falla el parseo
    }
}

// 2. Limpieza de texto para evitar errores de coincidencia
var genero_limpio = (genero != null) ? String(genero).trim().toUpperCase() : "DESCONOCIDO";
var rol_limpio = (rol_involucrado != null) ? String(rol_involucrado).trim().toUpperCase() : "DESCONOCIDO";



var lesion_limpia = (lesion_aparente != null) ? String(lesion_aparente).trim().toUpperCase() : "";</jsScript_script>
      </jsScript>
    </jsScripts>
