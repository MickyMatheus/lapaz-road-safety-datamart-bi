    <connection>Conexion1</connection>
    <sql>SELECT 
    p.nro_parte,
    p.fecha_suceso,
    p.id_ubicacion,
    u.macrodistrito,
    u.barrio_zona,
    u.calle_principal,
    p.id_condicion_entorno,
    ce.clima,
    ce.iluminacion,
    ce.estado_via,
    v.tipo AS tipo_vehiculo,
    v.marca,
    v.anio_fabricacion,
    dv.aseguradora_soat,
    dv.estado_vehiculo,
    per.ci AS ci_persona,
    per.fecha_nacimiento,
    per.genero,
    dp.rol_involucrado,
    dp.grado_alcohol_sangre,
    dp.lesion_aparente,
    tm.id_centro_medico
FROM Parte_Policial p
JOIN Ubicacion u ON p.id_ubicacion = u.id_ubicacion
JOIN Condicion_Entorno ce ON p.id_condicion_entorno = ce.id_condicion
JOIN Detalle_Persona_Parte dp ON p.nro_parte = dp.nro_parte
JOIN Persona per ON dp.ci = per.ci
JOIN Detalle_Vehiculo_Parte dv ON p.nro_parte = dv.nro_parte AND dp.placa_vehiculo = dv.placa
JOIN Vehiculo v ON dv.placa = v.placa
LEFT JOIN Traslado_Medico tm ON p.nro_parte = tm.nro_parte AND per.ci = tm.ci_victima;</sql>
