    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here

// 1. Estandarizar la Fecha
var fecha_limpia = fecha_suceso;

// Si la fecha contiene una barra '/', asumimos formato dd/mm/yyyy
if (fecha_suceso != null &amp;&amp; fecha_suceso.indexOf('/') > -1) {
    var partes = fecha_suceso.split('/');
    // Reposicionamos a yyyy-mm-dd
    fecha_limpia = partes[2] + '-' + partes[1] + '-' + partes[0];
}

// 2. Estandarizar la Hora
var hora_limpia = hora_suceso;

// Si la hora NO tiene ':' y tiene 4 caracteres (ej. '0830' o '1545')
if (hora_suceso != null &amp;&amp; hora_suceso.indexOf(':') == -1 &amp;&amp; hora_suceso.length == 4) {
    hora_limpia = hora_suceso.substr(0,2) + ':' + hora_suceso.substr(2,2);
}

var hora_entero = parseInt(hora_limpia.split(':')[0]);</jsScript_script>
      </jsScript>
    </jsScripts>
