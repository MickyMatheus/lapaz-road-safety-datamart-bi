        <value>41 a 60 años</value>
      </rule>
      <rule>
        <lower_bound>61.0</lower_bound>
        <upper_bound>120.0</upper_bound>
        <value>Mayor a 60 años</value>
      </rule>
      <rule>
        <lower_bound>990.0</lower_bound>
        <upper_bound>1.7976931348623157E308</upper_bound>
        <value>Edad Invalida / Error de Registro</value>
      </rule>
    </rules>
