    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// 1. CALCULAR EDAD (Cortando el texto)
var edad_calculada = -1; 

if (fecha_nacimiento != null) {
    // Convertimos a texto y sacamos los primeros 4 caracteres (el año)
    var anio_nac = parseInt(String(fecha_nacimiento).substr(0, 4));
    edad_calculada = 2026 - anio_nac;
}

// 2. FILTRAR EDADES ILÓGICAS
if (edad_calculada &lt; 0 || edad_calculada > 100) {
    edad_calculada = 999; 
}

// 3. CATEGORIZAR ALCOHOL (Esto lo dejamos igual porque funciona perfecto)
var estado_sobriedad = "DESCONOCIDO";
if (grado_alcohol_sangre != null) {
    if (grado_alcohol_sangre == 0.0) {
        estado_sobriedad = "SOBRIO";
    } else {
        estado_sobriedad = "ESTADO DE EBRIEDAD"; 
    }
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
